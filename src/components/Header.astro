---
import { Image } from 'astro:assets';
import { NAV, SITE } from '../data/site';
import chapterLogo from '../assets/images/brand/chapter-logo.png';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header" data-transparent={transparent ? 'true' : 'false'} id="site-header">
  <div class="site-header__bar container">
    <a href="/" class="site-header__brand" aria-label={`${SITE.shortName} home`}>
      <span class="site-header__logo-badge">
        <Image src={chapterLogo} alt="" width={220} height={116} class="site-header__logo" />
      </span>
      <span class="visually-hidden">{SITE.name}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {NAV.map((item) => (
          <li class="site-nav__item">
            {item.children ? (
              <div class="site-nav__dropdown-wrap">
                <button
                  class="site-nav__link site-nav__link--trigger"
                  aria-expanded="false"
                  aria-haspopup="true"
                  data-dropdown-trigger
                >
                  {item.label}
                  <svg class="site-nav__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                    <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <div class="site-nav__dropdown">
                  <a href={item.href} class="site-nav__dropdown-overview">{item.label} Overview</a>
                  <ul>
                    {item.children.map((child) => (
                      <li><a href={child.href} aria-current={isActive(child.href) ? 'page' : undefined}>{child.label}</a></li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <a href={item.href} class="site-nav__link" aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <button class="site-header__toggle" id="menu-toggle" aria-expanded="false" aria-controls="mobile-drawer">
      <span class="visually-hidden">Toggle menu</span>
      <span class="site-header__toggle-bars" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>
  </div>

  <div class="mobile-drawer" id="mobile-drawer" data-open="false">
    <nav aria-label="Mobile">
      <ul class="mobile-drawer__list">
        {NAV.map((item) => (
          <li>
            {item.children ? (
              <details class="mobile-drawer__details">
                <summary>{item.label}</summary>
                <ul>
                  <li><a href={item.href}>{item.label} Overview</a></li>
                  {item.children.map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-line);
    transition: background-color 0.4s var(--ease-out), border-color 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }

  .site-header[data-transparent='true']:not(.is-scrolled) {
    background: transparent;
    border-bottom-color: transparent;
  }

  .site-header.is-scrolled {
    box-shadow: 0 8px 30px -18px rgba(0, 0, 0, 0.35);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    transition: height 0.4s var(--ease-out);
  }

  .site-header.is-scrolled .site-header__bar {
    height: 68px;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .site-header__logo-badge {
    display: flex;
    align-items: center;
    background: var(--color-white);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.65rem;
    box-shadow: 0 2px 10px -4px rgba(0, 0, 0, 0.18);
    transition: padding 0.4s var(--ease-out);
  }

  .site-header.is-scrolled .site-header__logo-badge {
    padding: 0.3rem 0.5rem;
  }

  .site-header__logo {
    height: 40px;
    width: auto;
    display: block;
    transition: height 0.4s var(--ease-out);
  }

  .site-header.is-scrolled .site-header__logo {
    height: 32px;
  }

  .site-nav__list {
    display: none;
  }

  .site-header__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-ink);
    transition: color 0.4s var(--ease-out);
  }

  .site-header[data-transparent='true']:not(.is-scrolled) .site-header__toggle {
    color: var(--color-white);
  }

  .site-header__toggle-bars {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 22px;
  }

  .site-header__toggle-bars span {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
  }

  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bars span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bars span:nth-child(2) {
    opacity: 0;
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bars span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(360px, 86vw);
    height: 100vh;
    background: var(--color-forest-deep);
    color: var(--color-cream);
    transform: translateX(100%);
    transition: transform 0.45s var(--ease-out);
    z-index: 99;
    padding: calc(var(--header-h) + 1rem) 1.75rem 2rem;
    overflow-y: auto;
  }

  .mobile-drawer[data-open='true'] {
    transform: translateX(0);
  }

  .mobile-drawer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-drawer__list > li > a {
    display: block;
    padding: 0.9rem 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    text-decoration: none;
    color: var(--color-cream);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .mobile-drawer__details summary {
    padding: 0.9rem 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    cursor: pointer;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mobile-drawer__details summary::-webkit-details-marker {
    display: none;
  }

  .mobile-drawer__details summary::after {
    content: '+';
    font-size: 1.4rem;
    color: var(--color-gold);
  }

  .mobile-drawer__details[open] summary::after {
    content: '\2212';
  }

  .mobile-drawer__details ul {
    list-style: none;
    padding: 0.25rem 0 0.75rem 1rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .mobile-drawer__details ul a {
    display: block;
    padding: 0.55rem 0;
    color: rgba(251, 249, 244, 0.82);
    text-decoration: none;
    font-size: 0.98rem;
  }

  .mobile-drawer__details ul a:hover {
    color: var(--color-gold-light);
  }

  @media (min-width: 960px) {
    .site-header__toggle {
      display: none;
    }

    .mobile-drawer {
      display: none;
    }

    .site-nav__list {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .site-nav__item {
      position: relative;
    }

    .site-nav__link {
      display: inline-flex;
      align-items: center;
      gap: 0.35em;
      padding: 0.65rem 0.9rem;
      text-decoration: none;
      color: var(--color-ink);
      font-size: 0.92rem;
      font-weight: 500;
      background: transparent;
      border: none;
      font-family: var(--font-body);
      cursor: pointer;
      border-radius: 999px;
      transition: background-color 0.3s var(--ease-out), color 0.4s var(--ease-out);
    }

    .site-header[data-transparent='true']:not(.is-scrolled) .site-nav__link {
      color: var(--color-white);
    }

    .site-nav__link:hover,
    .site-nav__link[aria-current='page'] {
      background: rgba(27, 67, 50, 0.08);
    }

    .site-header[data-transparent='true']:not(.is-scrolled) .site-nav__link:hover {
      background: rgba(255, 255, 255, 0.14);
    }

    .site-nav__chevron {
      transition: transform 0.3s var(--ease-out);
    }

    .site-nav__dropdown-wrap:hover .site-nav__chevron,
    .site-nav__link--trigger[aria-expanded='true'] .site-nav__chevron {
      transform: rotate(180deg);
    }

    .site-nav__dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      margin-top: 0.5rem;
      min-width: 280px;
      background: var(--color-white);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card-hover);
      padding: 0.6rem;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out), visibility 0.25s;
    }

    .site-nav__dropdown-wrap:hover .site-nav__dropdown,
    .site-nav__dropdown-wrap:focus-within .site-nav__dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .site-nav__dropdown-overview {
      display: block;
      padding: 0.6rem 0.9rem;
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--color-emerald);
      text-decoration: none;
      border-bottom: 1px solid var(--color-line);
      margin-bottom: 0.35rem;
    }

    .site-nav__dropdown ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .site-nav__dropdown a {
      display: block;
      padding: 0.55rem 0.9rem;
      border-radius: var(--radius-sm);
      text-decoration: none;
      color: var(--color-ink);
      font-size: 0.92rem;
      transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
    }

    .site-nav__dropdown a:hover,
    .site-nav__dropdown a[aria-current='page'] {
      background: var(--color-cream-dim);
      color: var(--color-forest);
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const drawer = document.getElementById('mobile-drawer');

  function onScroll() {
    if (!header) return;
    if (window.scrollY > 24) {
      header.classList.add('is-scrolled');
    } else {
      header.classList.remove('is-scrolled');
    }
  }
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const isOpen = drawer?.getAttribute('data-open') === 'true';
    drawer?.setAttribute('data-open', String(!isOpen));
    toggle.setAttribute('aria-expanded', String(!isOpen));
    document.body.style.overflow = !isOpen ? 'hidden' : '';
  });

  document.querySelectorAll('[data-dropdown-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('[data-dropdown-trigger]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      btn.setAttribute('aria-expanded', String(!expanded));
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement)?.closest('.site-nav__dropdown-wrap')) {
      document.querySelectorAll('[data-dropdown-trigger]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
    }
  });

  // Close mobile drawer when a link inside it is clicked
  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      drawer.setAttribute('data-open', 'false');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });
</script>
