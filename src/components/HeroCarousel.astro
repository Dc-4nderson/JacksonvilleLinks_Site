---
import { Image } from 'astro:assets';
import { SITE } from '../data/site';

import chapterFormalPortrait from '../assets/images/hero/chapter-formal-portrait.jpg';
import chapterConferenceGroup from '../assets/images/hero/chapter-conference-group.jpg';
import chapterMeeting from '../assets/images/hero/chapter-meeting.jpg';
import chapterWhiteAttireGroup from '../assets/images/hero/chapter-white-attire-group.jpg';

const slides = [
  {
    src: chapterWhiteAttireGroup,
    alt: 'Jacksonville Links members in white attire gathered together outdoors',
  },
  {
    src: chapterConferenceGroup,
    alt: 'Jacksonville Links members gathered together at a chapter conference, dressed in green and white',
  },
  {
    src: chapterFormalPortrait,
    alt: 'Jacksonville Links members in formal white attire posing together on a staircase',
  },
  {
    src: chapterMeeting,
    alt: 'Jacksonville Links members at a chapter meeting',
  },
];
---

<section class="hero" aria-label="Welcome">
  <div class="hero__slides" role="group" aria-roledescription="carousel" aria-label="Chapter photos">
    {slides.map((slide, i) => (
      <div class="hero__slide" data-slide={i} aria-hidden={i === 0 ? 'false' : 'true'}>
        <Image
          src={slide.src}
          alt={slide.alt}
          width={1600}
          class="hero__slide-img"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
        />
      </div>
    ))}
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content container">
    <p class="hero__eyebrow" data-reveal>Jacksonville (FL) Chapter &middot; The Links, Incorporated &middot; Est. {SITE.founded}</p>
    <h1 class="hero__headline" data-reveal>{SITE.tagline}</h1>
    <p class="hero__sub lede" data-reveal>
      Sixty years of friendship and service — a chapter of professional women transforming
      lives in Jacksonville through the arts, education, health, and civic impact.
    </p>
    <div class="hero__actions" data-reveal>
      <a href="/our-chapter/" class="btn btn--primary">Discover Our Chapter</a>
      <a href="/programs/" class="btn btn--ghost">Explore Our Programs</a>
    </div>
  </div>

  <div class="hero__dots" role="tablist" aria-label="Slide selector">
    {slides.map((_, i) => (
      <button class="hero__dot" data-dot={i} aria-label={`Show slide ${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'} role="tab"></button>
    ))}
  </div>

  <a href="#facets" class="hero__scroll-cue" aria-label="Scroll to programs">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: var(--color-white);
    margin-top: calc(var(--header-h) * -1);
  }

  .hero__slides {
    position: absolute;
    inset: 0;
    background: var(--color-forest-deep);
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.6s ease-in-out;
    overflow: hidden;
  }

  .hero__slide[aria-hidden='false'] {
    opacity: 1;
  }

  .hero__slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    animation: kenburns 18s ease-in-out infinite;
  }

  @keyframes kenburns {
    0% { transform: scale(1); }
    50% { transform: scale(1.09); }
    100% { transform: scale(1); }
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(9, 22, 17, 0.92) 0%, rgba(9, 22, 17, 0.6) 42%, rgba(9, 22, 17, 0.4) 65%, rgba(9, 22, 17, 0.6) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(4rem, 10vw, 7rem);
    padding-top: calc(var(--header-h) + 2rem);
    max-width: 900px;
  }

  .hero__eyebrow {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold-light);
    margin-bottom: 1.25rem;
  }

  .hero__headline {
    color: var(--color-white);
    margin-bottom: 0.55em;
  }

  .hero__sub {
    color: rgba(255, 255, 255, 0.88);
    max-width: 56ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .hero__dots {
    position: absolute;
    right: clamp(1.25rem, 4vw, 3rem);
    bottom: clamp(2rem, 6vw, 3.5rem);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .hero__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }

  .hero__dot[aria-selected='true'] {
    background: var(--color-gold);
    border-color: var(--color-gold);
    transform: scale(1.2);
  }

  .hero__scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    transform: translateX(-50%);
    z-index: 2;
    width: 26px;
    height: 42px;
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    border-radius: 999px;
    display: none;
  }

  .hero__scroll-cue span {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-gold);
    animation: scrollcue 1.8s ease-in-out infinite;
  }

  @keyframes scrollcue {
    0% { opacity: 1; top: 8px; }
    70% { opacity: 0; top: 20px; }
    100% { opacity: 0; top: 20px; }
  }

  @media (min-width: 700px) {
    .hero__scroll-cue {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide-img {
      animation: none;
    }
    .hero__scroll-cue span {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.hero__slide'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.hero__dot'));
  let active = 0;
  let timer: ReturnType<typeof setInterval>;

  function show(i: number) {
    slides.forEach((s, idx) => s.setAttribute('aria-hidden', idx === i ? 'false' : 'true'));
    dots.forEach((d, idx) => d.setAttribute('aria-selected', idx === i ? 'true' : 'false'));
    active = i;
  }

  function next() {
    show((active + 1) % slides.length);
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (slides.length > 1 && !reduceMotion) {
    timer = setInterval(next, 6000);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      show(i);
      if (timer) {
        clearInterval(timer);
        timer = setInterval(next, 6000);
      }
    });
  });
</script>
