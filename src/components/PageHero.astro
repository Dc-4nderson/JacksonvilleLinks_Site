---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 data-reveal>{title}</h1>
    {lede && <p class="lede" data-reveal>{lede}</p>}
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(2rem, 5vw, 3.5rem);
    background: linear-gradient(180deg, var(--color-cream-dim), var(--color-cream));
    border-bottom: 1px solid var(--color-line);
  }
</style>
