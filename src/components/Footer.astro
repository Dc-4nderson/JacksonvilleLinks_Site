---
import { Image } from 'astro:assets';
import { SITE, NAV, EXTERNAL_LINKS } from '../data/site';
import chapterLogo from '../assets/images/brand/chapter-logo.png';

const year = new Date().getFullYear();
const quickLinks = NAV.flatMap((item) => (item.children ? [item, ...item.children] : [item]));
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__mark" aria-label={`${SITE.shortName} home`}>
        <span class="site-footer__logo-badge">
          <Image src={chapterLogo} alt="" width={260} height={137} class="site-footer__logo" />
        </span>
        <span class="visually-hidden">{SITE.name}</span>
      </a>
      <p class="site-footer__tagline">{SITE.tagline}</p>
      <p class="site-footer__founded">{SITE.foundedLabel}</p>
    </div>

    <nav class="site-footer__col" aria-label="Footer quick links">
      <h2>Quick Links</h2>
      <ul>
        {quickLinks.slice(0, 8).map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Footer more links">
      <h2>Explore</h2>
      <ul>
        {quickLinks.slice(8).map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li><a href="/members-only/">Members Only</a></li>
      </ul>
    </nav>

    <div class="site-footer__col">
      <h2>Contact</h2>
      <ul class="site-footer__contact">
        <li>{SITE.address}</li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      </ul>
      <h2 class="site-footer__org-heading">Our Organizations</h2>
      <ul class="site-footer__contact">
        {EXTERNAL_LINKS.map((link) => (
          <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="site-footer__bottom container">
    <p>&copy; {year} {SITE.name}. All rights reserved.</p>
    <p class="site-footer__motto">{SITE.motto}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-forest-deep);
    color: rgba(251, 249, 244, 0.82);
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .site-footer__mark {
    display: inline-flex;
    text-decoration: none;
    margin-bottom: 1.25rem;
  }

  .site-footer__logo-badge {
    display: flex;
    align-items: center;
    background: var(--color-white);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.85rem;
  }

  .site-footer__logo {
    height: 52px;
    width: auto;
    display: block;
  }

  .site-footer__tagline {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-gold-light);
    margin-bottom: 0.4rem;
  }

  .site-footer__founded {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 0;
  }

  .site-footer__col h2 {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold-light);
    margin-bottom: 1.1rem;
  }

  .site-footer__org-heading {
    margin-top: 1.75rem;
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .site-footer__col a {
    text-decoration: none;
    color: rgba(251, 249, 244, 0.82);
    font-size: 0.92rem;
    transition: color 0.25s var(--ease-out);
  }

  .site-footer__col a:hover {
    color: var(--color-gold-light);
  }

  .site-footer__contact {
    font-size: 0.92rem;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 1.75rem;
    font-size: 0.8rem;
    opacity: 0.65;
  }

  .site-footer__bottom p {
    margin: 0;
  }

  .site-footer__motto {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-gold-light);
    opacity: 1 !important;
  }

  @media (min-width: 700px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    }
  }
</style>
