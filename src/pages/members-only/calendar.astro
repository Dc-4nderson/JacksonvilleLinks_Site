---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import MembersGateGuard from '../../components/MembersGateGuard.astro';
---

<Layout title="Links Calendar" description="Links Calendar for members of the Jacksonville (FL) Chapter of The Links, Incorporated.">
  <MembersGateGuard />
  <PageHero eyebrow="Members Only" title="Links Calendar" />

  <section class="section">
    <div class="container stub" data-reveal>
      <p class="stub__badge">Placeholder — Members Only Content</p>
      <h2>Coming Soon</h2>
      <p class="lede">
        This page is a placeholder for the chapter meeting and event calendar. The original
        site keeps this password-protected, so its contents weren't available to pull into
        this rebuild. Provide a calendar embed (e.g. Google Calendar) or event list to publish
        here.
      </p>
      <a href="/members-only/" class="btn btn--outline">&larr; Back to Members Only</a>
    </div>
  </section>
</Layout>

<style>
  .stub {
    max-width: 640px;
  }
  .stub__badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--color-gold);
    color: var(--color-forest-deep);
    padding: 0.4em 0.9em;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }
</style>
