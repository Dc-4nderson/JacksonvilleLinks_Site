---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SubNav from '../../components/SubNav.astro';
import { NAV, FACETS } from '../../data/site';

export function getStaticPaths() {
  return FACETS.map((facet) => ({
    params: { slug: facet.slug },
    props: { facet },
  }));
}

const { facet } = Astro.props;
const programsNav = NAV.find((n) => n.label === 'Programs')!.children!;
const otherFacets = FACETS.filter((f) => f.slug !== facet.slug);
const hasMedia = Boolean(facet.image || facet.quote);
---

<Layout title={facet.name} description={facet.summary}>
  <PageHero eyebrow="Programs" title={facet.name} lede={facet.summary} />
  <SubNav items={programsNav} />

  <section class="section">
    <div class:list={['container facet-detail', { 'facet-detail--full': !hasMedia }]}>
      {hasMedia && (
        <div class="facet-detail__media" data-reveal>
          {facet.image && (
            <Image
              src={facet.image}
              alt={facet.imageAlt ?? `${facet.name} program photo`}
              width={facet.largeGallery ? 900 : 640}
              height={facet.largeGallery ? 675 : 480}
              class="facet-detail__img"
            />
          )}
          {facet.quote && (
            <blockquote class="facet-detail__quote">
              <p>&ldquo;{facet.quote.text}&rdquo;</p>
              <cite>{facet.quote.attribution}</cite>
            </blockquote>
          )}
        </div>
      )}
      <div class="facet-detail__body" data-reveal>
        <p class="facet-detail__mission">{facet.mission}</p>
        {facet.paragraphs.map((p) => <p>{p}</p>)}

        {facet.highlights.length > 0 && (
          <>
            <h3>Chapter Highlights</h3>
            <ul class="facet-detail__highlights">
              {facet.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </>
        )}
      </div>
    </div>

    {facet.gallery && facet.gallery.length > 0 && (
      <div class:list={['container facet-detail__gallery', { 'facet-detail__gallery--large': facet.largeGallery }]} data-reveal-group>
        {facet.gallery.map((g) => (
          <Image
            src={g.src}
            alt={g.alt}
            width={facet.largeGallery ? 700 : 400}
            height={facet.largeGallery ? 525 : 300}
            class="facet-detail__gallery-img"
          />
        ))}
      </div>
    )}

    {facet.resources && facet.resources.length > 0 && (
      <div class="container facet-detail__resources" data-reveal>
        <p class="eyebrow">Local Resource</p>
        {facet.resources.map((resource) => (
          <div class="resource-card">
            {resource.flyer && (
              <Image
                src={resource.flyer.src}
                alt={resource.flyer.alt}
                width={480}
                class="resource-card__flyer"
              />
            )}
            <div class="resource-card__body">
              <h3>{resource.name}</h3>
              {resource.description && <p>{resource.description}</p>}
              {resource.contact && <p class="resource-card__contact">{resource.contact}</p>}
              {resource.ctaHref && (
                <a href={resource.ctaHref} class="btn btn--outline btn--sm" target="_blank" rel="noopener noreferrer">
                  {resource.ctaLabel}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <section class="section section--tight other-facets">
    <div class="container">
      <p class="eyebrow" data-reveal>Explore More</p>
      <h2 data-reveal>Other Program Facets</h2>
      <div class="other-facets__grid" data-reveal-group>
        {otherFacets.map((f) => (
          <a class="other-facets__item" href={f.href}>
            {f.name}
            <svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
              <path d="M11 1L15 5L11 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M15 5H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .facet-detail {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .facet-detail__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .facet-detail__gallery {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .facet-detail__gallery-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  .facet-detail__gallery--large {
    max-width: 1000px;
  }

  .facet-detail__resources {
    margin-top: 2.5rem;
  }

  .resource-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: var(--color-cream-dim);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    max-width: 640px;
  }

  .resource-card__flyer {
    width: 100%;
    max-width: 280px;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    margin-inline: auto;
  }

  .resource-card__body h3 {
    margin-bottom: 0.6rem;
  }

  .resource-card__body p {
    font-size: 0.95rem;
  }

  .resource-card__contact {
    font-size: 0.85rem;
    color: var(--color-emerald);
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 560px) {
    .resource-card:has(.resource-card__flyer) {
      flex-direction: row;
      align-items: flex-start;
    }

    .resource-card__flyer {
      max-width: 200px;
      flex-shrink: 0;
      margin-inline: 0;
    }
  }

  @media (min-width: 700px) {
    .facet-detail__gallery {
      grid-template-columns: repeat(4, 1fr);
    }

    .facet-detail__gallery--large {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .facet-detail__quote {
    margin: 1.5rem 0 0;
    padding: 1.25rem 1.5rem;
    background: var(--color-cream-dim);
    border-left: 3px solid var(--color-gold);
    border-radius: var(--radius-sm);
  }

  .facet-detail__quote p {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-ink);
    margin-bottom: 0.4rem;
  }

  .facet-detail__quote cite {
    font-size: 0.85rem;
    color: var(--color-emerald);
    font-style: normal;
    font-weight: 600;
  }

  .facet-detail__mission {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-forest);
    max-width: 56ch;
  }

  .facet-detail__highlights {
    display: grid;
    gap: 0.6rem;
    padding-left: 0;
    list-style: none;
  }

  .facet-detail__highlights li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.95rem;
  }

  .facet-detail__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--color-gold);
    transform: rotate(45deg);
  }

  .other-facets {
    background: var(--color-cream-dim);
  }

  .other-facets__grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .other-facets__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.4rem;
    background: var(--color-white);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 600;
    box-shadow: var(--shadow-card);
    transition: transform 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }

  .other-facets__item:hover {
    transform: translateX(4px);
    color: var(--color-forest);
  }

  @media (min-width: 900px) {
    .facet-detail {
      grid-template-columns: 0.85fr 1.15fr;
    }

    .facet-detail--full {
      grid-template-columns: 1fr;
    }

    .facet-detail--full .facet-detail__body {
      max-width: 68ch;
    }
  }

  @media (min-width: 700px) {
    .other-facets__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
