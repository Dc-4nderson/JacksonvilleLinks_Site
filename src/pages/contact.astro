---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../data/site';
---

<Layout
  title="Contact"
  description={`Contact the Jacksonville (FL) Chapter of The Links, Incorporated. ${SITE.address}`}
>
  <PageHero eyebrow="Contact" title="We'd Love to Hear From You" lede="Questions about our chapter, our programs, or getting involved? Reach out." />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info" data-reveal>
        <h2>Get in Touch</h2>
        <dl>
          <div>
            <dt>Mailing Address</dt>
            <dd>{SITE.address}</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
          </div>
        </dl>
        <a href={`mailto:${SITE.email}`} class="btn btn--primary">Email the Chapter</a>
      </div>

      <div class="contact-form" data-reveal>
        <h2>Send a Message</h2>
        <div data-fs-success class="contact-form__success" hidden>
          Thank you! Your message has been sent. We'll get back to you soon.
        </div>
        <form id="contact-form" class="form">
          <div data-fs-error="" class="contact-form__error"></div>
          <div class="form__field">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" data-fs-field required autocomplete="name" />
            <span data-fs-error="name" class="form__field-error"></span>
          </div>
          <div class="form__field">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" data-fs-field required autocomplete="email" />
            <span data-fs-error="email" class="form__field-error"></span>
          </div>
          <div class="form__field">
            <label for="message">Message</label>
            <textarea id="message" name="message" data-fs-field rows="5" required></textarea>
            <span data-fs-error="message" class="form__field-error"></span>
          </div>
          <button type="submit" class="btn btn--outline" data-fs-submit-btn>Send Message</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    gap: 3rem;
  }

  .contact-info dl {
    margin: 1.5rem 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-info dt {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.3rem;
  }

  .contact-info dd {
    margin: 0;
    font-size: 1.05rem;
  }

  .contact-info dd a {
    color: var(--color-forest);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-form {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .contact-form__note {
    font-size: 0.85rem;
    background: var(--color-cream-dim);
    border: 1px dashed var(--color-gold);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    margin-bottom: 1.75rem;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form__field label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .form__field input,
  .form__field textarea {
    font-family: var(--font-body);
    font-size: 0.95rem;
    padding: 0.75em 0.9em;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-cream);
    color: var(--color-ink);
    resize: vertical;
    transition: border-color 0.25s var(--ease-out);
  }

  .form__field input:focus,
  .form__field textarea:focus {
    outline: none;
    border-color: var(--color-emerald);
  }

  .form button[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form button[disabled]:hover {
    transform: none;
  }

  /*
   * @formspree/ajax injects its own <style> at runtime (targeting these
   * same [data-fs-*] attributes) to show/hide these elements and set a
   * default red/green color scheme. Because it's injected after this
   * page's stylesheet, its rules win ties on specificity — so these use
   * the same attribute-selector shape with !important to guarantee the
   * site's own palette, rather than the library's defaults, is what
   * actually renders.
   */
  .contact-form [data-fs-success][data-fs-active] {
    font-family: var(--font-body) !important;
    font-size: 0.9rem !important;
    color: var(--color-forest-deep) !important;
    background: var(--color-gold-light) !important;
    border: none !important;
    border-radius: var(--radius-sm) !important;
    padding: 0.85rem 1rem !important;
    margin-bottom: 1.5rem !important;
  }

  .contact-form [data-fs-error][data-fs-active] {
    font-family: var(--font-body) !important;
    color: #b3261e !important;
  }

  .contact-form [data-fs-error=""][data-fs-active] {
    background: var(--color-cream-dim) !important;
    border: 1px solid #b3261e !important;
    border-radius: var(--radius-sm) !important;
    padding: 0.85rem 1rem !important;
    font-size: 0.9rem !important;
    margin-bottom: 1.5rem !important;
  }

  .form__field-error {
    font-size: 0.8rem !important;
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
</style>

<script>
  import { initForm } from '@formspree/ajax';

  initForm({ formElement: '#contact-form', formId: 'mwvgzapy' });
</script>
