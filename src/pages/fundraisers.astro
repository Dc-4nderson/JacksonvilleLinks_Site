---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import { SITE } from '../data/site';

// The Western Gala is a real, named chapter fundraiser (per the current
// live site), but its date/venue/details aren't published anywhere we
// could pull from — those still need to come from the chapter. The
// second entry is a generic sample layout, not a real event name.
const events = [
  {
    flag: 'Real Event — Details Needed',
    title: 'Western Gala',
    date: 'Date to be announced',
    location: 'Location to be announced',
    summary: 'The Jacksonville Chapter’s signature fundraising gala, supporting programming across all five facets. Details (date, venue, tickets) to be confirmed by the chapter.',
    variant: 1 as const,
  },
  {
    flag: 'Sample Placeholder Event',
    title: 'Sample Event: Links Golf Classic',
    date: 'Date to be announced',
    location: 'Location to be announced',
    summary: 'A community golf tournament benefiting chapter programs across all five facets. Replace with the chapter’s actual event details.',
    variant: 2 as const,
  },
];
---

<Layout
  title="Fundraisers"
  description="Upcoming fundraisers and events hosted by the Jacksonville (FL) Chapter of The Links, Incorporated."
>
  <PageHero
    eyebrow="Fundraisers"
    title="Upcoming Events"
    lede="Every fundraiser we host powers our five program facets — from youth mentoring to health equity to the arts. Details on upcoming events will be posted here as they're confirmed."
  />

  <section class="section">
    <div class="container">
      <div class="events-notice" data-reveal>
        <strong>Content note:</strong> the Western Gala is a real, named chapter fundraiser,
        but we don't have a confirmed date, venue, or ticket link for it yet. The Golf Classic
        below is a sample layout only, not a real event name. Both need real details from the
        chapter before launch.
      </div>

      <div class="events-grid" data-reveal-group>
        {events.map((event) => (
          <article class="event-card">
            <div class="event-card__media">
              <PlaceholderImage label={`${event.title} photo`} ratio="16/9" rounded="lg" variant={event.variant} />
              <span class="event-card__flag">{event.flag}</span>
            </div>
            <div class="event-card__body">
              <p class="event-card__date">{event.date}</p>
              <h3>{event.title}</h3>
              <p class="event-card__location">{event.location}</p>
              <p>{event.summary}</p>
              <a href={`mailto:${SITE.email}`} class="btn btn--outline btn--sm">Contact for Details</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight cta-strip">
    <div class="container cta-strip__inner" data-reveal>
      <div>
        <h2>Have a Fundraiser to Announce?</h2>
        <p class="lede">Chapter officers can send event details to be added to this page.</p>
      </div>
      <a href="/contact/" class="btn btn--primary">Contact the Chapter</a>
    </div>
  </section>
</Layout>

<style>
  .events-notice {
    background: var(--color-cream-dim);
    border: 1px dashed var(--color-gold);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    font-size: 0.9rem;
    margin-bottom: 2.5rem;
    max-width: 70ch;
  }

  .events-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  .event-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 0.85rem;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }

  .event-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-card-hover);
  }

  .event-card__media {
    position: relative;
  }

  .event-card__flag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: rgba(18, 44, 34, 0.85);
    color: var(--color-cream);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.4em 0.75em;
    border-radius: 999px;
    max-width: calc(100% - 5.5rem);
  }

  .event-card__body {
    padding: 1.5rem 0.9rem 0.9rem;
  }

  .event-card__date {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.5rem;
  }

  .event-card__location {
    font-size: 0.88rem;
    color: var(--color-emerald);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .cta-strip {
    background: var(--color-forest);
    color: var(--color-white);
  }

  .cta-strip__inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
  }

  .cta-strip h2 {
    color: var(--color-white);
    margin-bottom: 0.4rem;
  }

  .cta-strip .lede {
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  @media (min-width: 700px) {
    .events-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 640px) {
    .cta-strip__inner {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
