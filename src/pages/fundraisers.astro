---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../data/site';
---

<Layout
  title="Fundraisers"
  description="Upcoming fundraisers and events hosted by the Jacksonville (FL) Chapter of The Links, Incorporated."
>
  <PageHero
    eyebrow="Fundraisers"
    title="Upcoming Events"
    lede="Every fundraiser we host powers our five program facets — from youth mentoring to health equity to the arts."
  />

  <section class="section">
    <div class="container stub" data-reveal>
      <p class="stub__badge">Coming Soon</p>
      <h2>Event Details Coming Soon</h2>
      <p class="lede">
        We're finalizing details for upcoming chapter fundraisers, including the Western Gala.
        Check back soon, or contact the chapter directly for the latest information.
      </p>
      <a href={`mailto:${SITE.email}`} class="btn btn--primary">Contact the Chapter</a>
    </div>
  </section>
</Layout>

<style>
  .stub {
    max-width: 640px;
  }
  .stub__badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--color-gold);
    color: var(--color-forest-deep);
    padding: 0.4em 0.9em;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }
</style>
