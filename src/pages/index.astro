---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import FacetCard from '../components/FacetCard.astro';
import { SITE, FACETS, PRESIDENT_LETTER } from '../data/site';
import presidentPortrait from '../assets/images/president/portrait.jpg';
---

<Layout
  title="Home"
  description="The Jacksonville (FL) Chapter of The Links, Incorporated — professional women united in friendship and service since 1966. Building. Better. Together."
  transparentHeader
>
  <HeroCarousel />

  <section class="section president">
    <div class="container president__grid">
      <div class="president__media" data-reveal>
        <Image
          src={presidentPortrait}
          alt={`Portrait of ${SITE.president}, President of the Jacksonville (FL) Chapter of The Links, Incorporated`}
          width={420}
          height={560}
          class="president__portrait"
        />
        <p class="president__caption">
          <strong>{SITE.president}</strong><br />
          President, {SITE.name}
        </p>
      </div>
      <div class="president__copy" data-reveal>
        <p class="eyebrow">A Message From Our President</p>
        <p class="president__dropcap-para">
          <span class="president__dropcap" aria-hidden="true">{PRESIDENT_LETTER.salutation[0]}</span>{PRESIDENT_LETTER.salutation.slice(1)}
        </p>
        {PRESIDENT_LETTER.paragraphs.map((p) => <p>{p}</p>)}
        <p class="president__motto">{PRESIDENT_LETTER.closing}</p>
        <p class="president__sign">
          <strong>{SITE.president}</strong><br />
          President, {SITE.name}
        </p>
      </div>
    </div>
  </section>

  <section class="section facets" id="facets">
    <div class="container">
      <div class="facets__intro">
        <p class="eyebrow" data-reveal>What We Do</p>
        <h2 data-reveal>Five Facets, One Mission</h2>
        <p class="lede" data-reveal>
          Every Jacksonville Links program lives within five national program facets —
          the pillars that guide our service to youth, the arts, and the health and
          well-being of our community, at home and abroad.
        </p>
      </div>
      <div class="facets__grid" data-reveal-group>
        {FACETS.map((facet, i) => <FacetCard facet={facet} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container cta-band__inner" data-reveal>
      <div>
        <p class="eyebrow" style="color: var(--color-gold-light);">Get Involved</p>
        <h2>Join Us in Friendship and Service</h2>
        <p class="lede" style="color: rgba(255,255,255,0.85);">
          Learn about upcoming fundraisers, chapter events, and how to connect with the
          Jacksonville Chapter of The Links, Incorporated.
        </p>
      </div>
      <div class="cta-band__actions">
        <a href="/fundraisers/" class="btn btn--primary">Upcoming Fundraisers</a>
        <a href="/contact/" class="btn btn--ghost">Contact the Chapter</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .facets {
    background: var(--color-white);
    border-bottom: 1px solid var(--color-line);
  }

  .facets__intro {
    max-width: 720px;
    margin-bottom: 3rem;
  }

  .facets__grid {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: 1fr;
  }

  .president {
    background: var(--color-cream-dim);
  }

  .president__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .president__media {
    max-width: 340px;
    margin-inline: auto;
  }

  .president__portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 3/4;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .president__caption {
    margin-top: 1rem;
    font-size: 0.92rem;
    text-align: center;
  }

  .president__copy {
    max-width: 66ch;
  }

  .president__dropcap-para {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .president__dropcap {
    float: left;
    font-family: var(--font-display);
    font-size: 3.4rem;
    line-height: 0.8;
    padding: 0.06em 0.12em 0 0;
    color: var(--color-gold);
    font-weight: 600;
  }

  .president__sign {
    margin-bottom: 0;
  }

  .president__motto {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-emerald);
    margin-bottom: 0.25rem;
  }

  .cta-band {
    background: linear-gradient(135deg, var(--color-forest-deep), var(--color-forest));
    color: var(--color-white);
  }

  .cta-band__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
    justify-content: space-between;
  }

  .cta-band h2 {
    color: var(--color-white);
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    flex-shrink: 0;
  }

  @media (min-width: 800px) {
    .facets__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .president__grid {
      grid-template-columns: 0.75fr 1.25fr;
    }
  }

  @media (min-width: 1100px) {
    .facets__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .cta-band__inner {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
