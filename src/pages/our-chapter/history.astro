---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SubNav from '../../components/SubNav.astro';
import { NAV, HISTORY_CONTENT } from '../../data/site';
import nationalFounders from '../../assets/images/history/national-founders.jpg';

const ourChapterNav = NAV.find((n) => n.label === 'Our Chapter')!.children!;
---

<Layout
  title="History"
  description="The history of the Jacksonville (FL) Chapter of The Links, Incorporated, chartered November 12, 1966 as the Southern Area's 27th chapter."
>
  <PageHero eyebrow="Our Chapter" title="A Legacy in Every Link" lede="60 years of friendship and service in Jacksonville." />
  <SubNav items={ourChapterNav} />

  <section class="section">
    <div class="container history-article">
      <div class="history-article__body" data-reveal>
        <h2>{HISTORY_CONTENT.heading}</h2>
        {HISTORY_CONTENT.paragraphs.map((p) => <p>{p}</p>)}
        <p>{HISTORY_CONTENT.fundraisersIntro}</p>
        <ul class="history-article__list">
          {HISTORY_CONTENT.fundraisers.map((f) => <li>{f}</li>)}
        </ul>
        <a href="/our-chapter/charter-members/" class="btn btn--outline">Meet All 15 Charter Members</a>
      </div>
      <figure class="history-article__figure" data-reveal>
        <Image
          src={nationalFounders}
          alt="The Links, Incorporated founders — Margaret Roselle Hawkins and Sarah Strickland Scott"
          width={360}
          height={252}
          class="history-article__figure-img"
        />
      </figure>
    </div>
  </section>
</Layout>

<style>
  .history-article {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .history-article__body {
    max-width: 70ch;
  }

  .history-article__body p {
    margin-bottom: 1.1rem;
  }

  .history-article__list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .history-article__list li {
    position: relative;
    padding-left: 1.4rem;
  }

  .history-article__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--color-gold);
    transform: rotate(45deg);
  }

  .history-article__figure {
    margin: 0;
  }

  .history-article__figure-img {
    width: 100%;
    height: auto;
    aspect-ratio: 10/7;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  @media (min-width: 900px) {
    .history-article {
      grid-template-columns: 1.4fr 0.8fr;
    }

    .history-article__figure {
      position: sticky;
      top: 6.5rem;
    }
  }
</style>
