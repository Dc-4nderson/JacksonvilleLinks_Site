---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SubNav from '../../components/SubNav.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import { NAV, FIRST_OFFICERS } from '../../data/site';

const ourChapterNav = NAV.find((n) => n.label === 'Our Chapter')!.children!;

const timeline = [
  {
    year: '1946',
    title: 'The Links, Incorporated Founded',
    body: 'The Links, Incorporated is established as an international, not-for-profit corporation dedicated to friendship and service.',
  },
  {
    year: '1966',
    title: 'Jacksonville Chapter Chartered',
    body: 'The Jacksonville Chapter is officially installed on November 12, 1966, as the Southern Area’s 27th chapter, with Elinor Littlejohn serving as chartering president and fourteen fellow founders by her side.',
  },
  {
    year: '2012–2014',
    title: 'National First Place Award',
    body: 'The chapter receives the National FIRST PLACE Award for Umbrella Programming for its GEMS initiative, serving sixth-grade girls at Eugene Butler Middle School.',
  },
  {
    year: '2017–2018',
    title: 'International Impact in Haiti',
    body: 'Members support 34 orphans at the Ecole Yahve Schamma de Petit Place in Cazeau, Haiti, preparing individual care packages and bulk donations.',
  },
  {
    year: 'Today',
    title: 'A Legacy in Every Link',
    body: 'Over more than five decades, the chapter has donated over $150,000 to local organizations including the United Negro College Fund, Boy Scouts, YMCA, and Edward Waters College.',
  },
];
---

<Layout
  title="History"
  description="The history of the Jacksonville (FL) Chapter of The Links, Incorporated, chartered November 12, 1966 as the Southern Area's 27th chapter."
>
  <PageHero eyebrow="Our Chapter" title="A Legacy in Every Link" lede="60 years of friendship and service in Jacksonville." />
  <SubNav items={ourChapterNav} />

  <section class="section">
    <div class="container timeline">
      {timeline.map((item) => (
        <div class="timeline__item" data-reveal>
          <div class="timeline__year">{item.year}</div>
          <div class="timeline__content">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section section--tight founders">
    <div class="container founders__grid">
      <div data-reveal>
        <p class="eyebrow">November 12, 1966</p>
        <h2>Our Chartering Officers</h2>
        <p>
          The Jacksonville Chapter's first slate of officers guided the chapter through its earliest years of
          service.
        </p>
        <ul class="founders__list">
          {FIRST_OFFICERS.map((o) => (
            <li><strong>{o.name}</strong> — {o.title}</li>
          ))}
        </ul>
        <a href="/our-chapter/charter-members/" class="btn btn--outline">Meet All 15 Charter Members</a>
      </div>
      <div data-reveal>
        <PlaceholderImage label="Archival photo of the 1966 charter ceremony" ratio="4/3" rounded="lg" variant={4} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 820px;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 84px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--color-line);
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 1.5rem;
    padding-block: 1.5rem;
    position: relative;
  }

  .timeline__year {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-forest);
    font-size: 1rem;
    text-align: right;
    padding-top: 0.15rem;
  }

  .timeline__content {
    position: relative;
    padding-left: 2rem;
  }

  .timeline__content::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 0.4rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-gold);
    border: 2px solid var(--color-cream);
    box-shadow: 0 0 0 2px var(--color-gold);
  }

  .timeline__content h3 {
    margin-bottom: 0.4rem;
  }

  .founders {
    background: var(--color-cream-dim);
  }

  .founders__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .founders__list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.95rem;
  }

  @media (min-width: 900px) {
    .founders__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
