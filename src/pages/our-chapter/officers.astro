---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SubNav from '../../components/SubNav.astro';
import { NAV, OFFICERS, LEGACY_TAGLINE } from '../../data/site';

import presidentPortrait from '../../assets/images/president/portrait.jpg';
import vicePresidentCard from '../../assets/images/officers/vice-president.jpg';
import recordingSecretaryCard from '../../assets/images/officers/recording-secretary.jpg';
import correspondingSecretaryCard from '../../assets/images/officers/corresponding-secretary.jpg';
import financialSecretaryCard from '../../assets/images/officers/financial-secretary.jpg';
import treasurerCard from '../../assets/images/officers/treasurer.jpg';
import programmingChairCard from '../../assets/images/officers/programming-chair.jpg';
import parliamentarianCard from '../../assets/images/officers/parliamentarian.jpg';
import chaplainCard from '../../assets/images/officers/chaplain.jpg';

const cardImages = {
  'vice-president': vicePresidentCard,
  'recording-secretary': recordingSecretaryCard,
  'corresponding-secretary': correspondingSecretaryCard,
  'financial-secretary': financialSecretaryCard,
  'treasurer': treasurerCard,
  'programming-chair': programmingChairCard,
  'parliamentarian': parliamentarianCard,
  'chaplain': chaplainCard,
} as const;

const ourChapterNav = NAV.find((n) => n.label === 'Our Chapter')!.children!;
const electedOfficers = OFFICERS.filter((o) => o.group === 'elected');
const appointedOfficers = OFFICERS.filter((o) => o.group === 'appointed');
---

<Layout
  title="Officers"
  description="Meet the elected and appointed officers leading the Jacksonville (FL) Chapter of The Links, Incorporated."
>
  <PageHero eyebrow="Our Chapter" title="2025–2026 Chapter Officers" />
  <SubNav items={ourChapterNav} />

  <p class="legacy-tagline" data-reveal>{LEGACY_TAGLINE}</p>

  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>2025–2026 Elected Officers</p>
      <ul class="officer-grid officer-grid--elected" data-reveal-group>
        {electedOfficers.map((officer) => (
          <li class="officer-card">
            {'card' in officer && officer.card ? (
              <Image
                src={cardImages[officer.card]}
                alt={`${officer.name}, ${officer.title} of the Jacksonville (FL) Chapter of The Links, Incorporated`}
                width={440}
                height={440}
                class="officer-card__graphic"
              />
            ) : (
              <div class="officer-card__frame">
                <Image
                  src={presidentPortrait}
                  alt={`Portrait of ${officer.name}, ${officer.title}`}
                  width={320}
                  height={427}
                  class="officer-card__photo"
                />
                <h3>{officer.name}</h3>
                <p>{officer.title}</p>
              </div>
            )}
          </li>
        ))}
      </ul>

      <p class="eyebrow officer-section-spacer" data-reveal>2025–2026 Appointed Officers</p>
      <ul class="officer-grid" data-reveal-group>
        {appointedOfficers.map((officer) => (
          <li class="officer-card">
            <Image
              src={cardImages[officer.card]}
              alt={`${officer.name}, ${officer.title} of the Jacksonville (FL) Chapter of The Links, Incorporated`}
              width={440}
              height={440}
              class="officer-card__graphic"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .legacy-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    text-align: center;
    color: var(--color-forest);
    font-size: clamp(1.15rem, 1.6vw + 0.7rem, 1.6rem);
    max-width: 46ch;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0;
  }

  .officer-section-spacer {
    margin-top: 3.5rem;
  }

  .officer-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }

  .officer-card {
    text-align: center;
  }

  .officer-card__frame {
    max-width: 340px;
    margin-inline: auto;
    background: var(--color-emerald);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.1rem 1.5rem;
    box-shadow: var(--shadow-card);
  }

  .officer-card__photo {
    max-width: 100%;
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    border-radius: calc(var(--radius-md) - 0.3rem);
    margin-bottom: 0.9rem;
  }

  .officer-card__frame h3 {
    color: var(--color-white);
    font-size: 1.1rem;
    margin-bottom: 0.15rem;
  }

  .officer-card__graphic {
    width: 100%;
    max-width: 340px;
    margin-inline: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }

  .officer-card__graphic:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .officer-card h3 {
    margin-bottom: 0.2rem;
    font-size: 1.1rem;
  }

  .officer-card p {
    margin: 0;
    color: var(--color-emerald);
    font-weight: 600;
    font-size: 0.88rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .officer-card .officer-card__frame p {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
    font-size: 0.88rem;
    text-transform: none;
    letter-spacing: normal;
  }
</style>
