---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SubNav from '../../components/SubNav.astro';
import { NAV, SITE, OUR_CHAPTER_CONTENT } from '../../data/site';
import chapterGroupPhoto from '../../assets/images/hero/chapter-conference-group.jpg';
import nationalFounders from '../../assets/images/history/national-founders.jpg';

const ourChapterNav = NAV.find((n) => n.label === 'Our Chapter')!.children!;
---

<Layout
  title="Our Chapter"
  description="Meet the Jacksonville (FL) Chapter of The Links, Incorporated: our president, our history since 1966, our officers, and our members."
>
  <PageHero
    eyebrow="Our Chapter"
    title="Sixty Years of Friendship and Service"
    lede={`Since ${SITE.founded}, the Jacksonville Chapter has united accomplished women in a shared commitment to friendship and service across our community.`}
  />
  <SubNav items={ourChapterNav} />

  <section class="section">
    <div class="container overview-grid">
      <div data-reveal>
        <Image
          src={nationalFounders}
          alt="The Links, Incorporated founders, Margaret Roselle Hawkins and Sarah Strickland Scott"
          width={640}
          height={480}
          class="overview-photo"
        />
      </div>
      <div data-reveal>
        <p class="eyebrow">The Links, Incorporated</p>
        <h2>An Enduring Sisterhood of Service</h2>
        {OUR_CHAPTER_CONTENT.linksIncorporated.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section section--tight chapter-section">
    <div class="container overview-grid overview-grid--reverse">
      <div data-reveal>
        <p class="eyebrow">The Jacksonville Chapter of The Links, Incorporated</p>
        {OUR_CHAPTER_CONTENT.jacksonvilleChapter.map((p) => <p>{p}</p>)}
      </div>
      <div data-reveal>
        <Image
          src={chapterGroupPhoto}
          alt="Jacksonville Links members gathered together at a chapter conference, dressed in green and white"
          width={640}
          height={480}
          class="overview-photo"
        />
      </div>
    </div>
  </section>

  <section class="section section--tight national-context">
    <div class="container">
      <p class="eyebrow">The Links Foundation, Incorporated</p>
      {OUR_CHAPTER_CONTENT.foundation.map((p) => <p class="lede">{p}</p>)}
      <a
        href={OUR_CHAPTER_CONTENT.visionLink.href}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--outline"
      >
        {OUR_CHAPTER_CONTENT.visionLink.label}
      </a>
    </div>
  </section>

  <section class="section section--tight links-grid-section">
    <div class="container">
      <div class="links-grid" data-reveal-group>
        {ourChapterNav.map((item) => (
          <a class="links-grid__item" href={item.href}>
            <span>{item.label}</span>
            <svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
              <path d="M11 1L15 5L11 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M15 5H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .overview-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .overview-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .chapter-section {
    background: var(--color-cream-dim);
  }

  .national-context {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .national-context .lede {
    max-width: 72ch;
    margin-bottom: 1.25rem;
  }

  .national-context .btn {
    margin-top: 0.5rem;
  }

  .links-grid-section {
    background: var(--color-cream-dim);
  }

  .links-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  .links-grid__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    background: var(--color-white);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 600;
    box-shadow: var(--shadow-card);
    transition: transform 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }

  .links-grid__item:hover {
    transform: translateX(4px);
    color: var(--color-forest);
  }

  @media (min-width: 900px) {
    .overview-grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .overview-grid--reverse {
      grid-template-columns: 1.1fr 0.9fr;
    }
    .links-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
