---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SubNav from '../../components/SubNav.astro';
import { NAV, SITE, PRESIDENT_LETTER } from '../../data/site';
import presidentPortrait from '../../assets/images/president/portrait.jpg';

const ourChapterNav = NAV.find((n) => n.label === 'Our Chapter')!.children!;
---

<Layout
  title="Message From The President"
  description={`A welcome message from ${SITE.president}, President of the Jacksonville (FL) Chapter of The Links, Incorporated.`}
>
  <PageHero eyebrow="Our Chapter" title="Message From The President" />
  <SubNav items={ourChapterNav} />

  <section class="section">
    <div class="container letter-grid">
      <div class="letter-grid__portrait" data-reveal>
        <Image
          src={presidentPortrait}
          alt={`Portrait of ${SITE.president}, President of the Jacksonville (FL) Chapter of The Links, Incorporated`}
          width={420}
          height={560}
          class="letter-grid__portrait-img"
        />
        <p class="letter-grid__caption">
          <strong>{SITE.president}</strong><br />
          President, {SITE.name}
        </p>
      </div>
      <div class="letter-grid__body" data-reveal>
        <p class="letter-grid__dropcap-para">
          <span class="dropcap" aria-hidden="true">{PRESIDENT_LETTER.salutation[0]}</span>{PRESIDENT_LETTER.salutation.slice(1)}
        </p>
        {PRESIDENT_LETTER.paragraphs.map((p) => <p>{p}</p>)}
        <p class="letter-grid__motto">{PRESIDENT_LETTER.closing}</p>
        <p class="letter-grid__signature">{SITE.president}<br /><span>President, {SITE.name}</span></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .letter-grid {
    display: grid;
    gap: 2.5rem;
  }

  .letter-grid__portrait {
    max-width: 340px;
  }

  .letter-grid__portrait-img {
    width: 100%;
    height: auto;
    aspect-ratio: 3/4;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .letter-grid__caption {
    margin-top: 1rem;
    font-size: 0.92rem;
    text-align: center;
  }

  .letter-grid__body {
    max-width: 66ch;
  }

  .dropcap {
    float: left;
    font-family: var(--font-display);
    font-size: 4.2rem;
    line-height: 0.78;
    padding: 0.06em 0.1em 0 0;
    color: var(--color-gold);
    font-weight: 600;
  }

  .letter-grid__motto {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-emerald);
    margin-bottom: 0.25rem;
  }

  .letter-grid__signature {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .letter-grid__signature span {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--color-body);
  }

  @media (min-width: 900px) {
    .letter-grid {
      grid-template-columns: 320px 1fr;
    }
  }
</style>
