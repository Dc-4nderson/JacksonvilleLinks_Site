---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  transparentHeader?: boolean;
  image?: string;
}

const {
  title,
  description,
  transparentHeader = false,
  image = '/images/og-default.jpg',
} = Astro.props;

const pageTitle = title === SITE.shortName ? title : `${title} | ${SITE.shortName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const ogImageURL = new URL(image, Astro.site ?? SITE.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b4332" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={SITE.shortName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script is:inline>
      // Set before paint so scroll-reveal CSS only hides content when JS
      // is actually available to reveal it again — see global.css.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const revealEls = document.querySelectorAll('[data-reveal], [data-reveal-group]');
      if ('IntersectionObserver' in window && revealEls.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));

        // Safety net: if something never intersects (e.g. captured in a
        // fullPage screenshot tool, or an edge-case layout), don't leave
        // it invisible forever.
        window.setTimeout(() => {
          revealEls.forEach((el) => el.classList.add('is-visible'));
          io.disconnect();
        }, 4000);
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
